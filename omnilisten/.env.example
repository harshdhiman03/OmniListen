# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron Authentication Secret
CRON_SECRET=your-cron-secret-key

# AI Provider API Keys
# Google Gemini API Key (Default Provider for Text Generation & Embeddings)
GEMINI_API_KEY=your-gemini-api-key

# Groq API Key (Optional Fallback / Alternative LLM Provider)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# GNews API Key (Optional Macro News Ingestion Source)
GNEWS_API_KEY=your-gnews-api-key
