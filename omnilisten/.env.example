# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron Authentication Secret
CRON_SECRET=your-cron-secret-key

# AI Provider Strategy & Config
# Options: 'auto' (Gemini -> Groq fallback) | 'gemini' | 'groq'
LLM_PROVIDER=auto

# Model String Configurations (Adjustable without code edits)
GEMINI_MODEL_NAME=gemini-2.5-flash
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# AI Provider API Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# GNews API Key (Optional Macro News Ingestion Source)
GNEWS_API_KEY=your-gnews-api-key
